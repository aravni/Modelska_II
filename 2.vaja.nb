Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y", ",", "\[Alpha]", ",", "F"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"res", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"F", "'"}], "[", "s", "]"}], "==", 
        RowBox[{
         RowBox[{"Sin", "[", 
          RowBox[{"\[Alpha]", "[", "s", "]"}], "]"}], "-", 
         RowBox[{"\[Beta]", " ", 
          RowBox[{"x", "[", "s", "]"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"\[Alpha]", "[", "s", "]"}], "]"}]}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Alpha]", "'"}], "[", "s", "]"}], "==", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"F", "[", "s", "]"}]}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"\[Alpha]", "[", "s", "]"}], "]"}], "+", 
           RowBox[{"\[Beta]", " ", 
            RowBox[{"x", "[", "s", "]"}], " ", 
            RowBox[{"Sin", "[", 
             RowBox[{"\[Alpha]", "[", "s", "]"}], "]"}]}]}], ")"}]}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "s", "]"}], "==", 
        RowBox[{"Cos", "[", 
         RowBox[{"\[Alpha]", "[", "s", "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"y", "'"}], "[", "s", "]"}], "==", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Alpha]", "[", "s", "]"}], "]"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "0", "]"}], "==", "0"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"x", "[", "L", "]"}], "==", "0"}], ",", 
       RowBox[{
        RowBox[{"y", "[", "L", "]"}], "==", "yL"}]}], "\[IndentingNewLine]", 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"F", ",", "\[Alpha]", ",", "x", ",", "y"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"s", ",", "0", ",", "L"}], "}"}], ",", 
     RowBox[{"Method", "->", "\"\<Shooting\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"xr", "[", "s_", "]"}], ",", 
     RowBox[{"yr", "[", "s_", "]"}], ",", 
     RowBox[{"\[Alpha]r", "[", "s_", "]"}], ",", 
     RowBox[{"Fr", "[", "s_", "]"}]}], "}"}], "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", "[", "s", "]"}], ",", 
      RowBox[{"y", "[", "s", "]"}], ",", 
      RowBox[{"\[Alpha]", "[", "s", "]"}], ",", 
      RowBox[{"F", "[", "s", "]"}]}], "}"}], "/.", 
    RowBox[{"res", "[", 
     RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}]}], "Input",

Cell["DETAILS", "DetailsSection"],

Cell["\<\
Panel methods are numerical models for solving potential flow over an object, \
usually of relatively complex geometry. These methods are based on a \
boundary-integral solution to Laplace's equation. Source, vortex, or doublet \
singularities are placed on the boundary of the object and suitable boundary \
conditions are applied. Refer to [2] for details.\
\>", "DetailNotes",
 CellID->1197278],

Cell[TextData[{
 "The panel method implemented in this Demonstration uses vortex panels and \
external Neumann boundary conditions. The discretized airfoil is specified by \
",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineMath"],
 " straightline panels, where the circulation density for each panel varies \
linearly with distance from the beginning of the panel. "
}], "DetailNotes",
 CellID->575318166],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"\[Gamma]", "(", 
     SubscriptBox["x", "j"], ")"}], "=", 
    RowBox[{
     SubscriptBox["a", "j"], "+", 
     RowBox[{
      SubscriptBox["b", "j"], " ", "x"}]}]}], TraditionalForm]], "InlineMath"],
 "  for ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"j", "=", "1"}], ",", "2", ",", "3", ",", "\[Ellipsis]", ",", 
    "N"}], TraditionalForm]], "InlineMath"],
 "."
}], "DetailNotes",
 CellID->1160486001],

Cell[TextData[{
 "Strength parameters are denoted by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["a", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula"],
 ", ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["b", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula"],
 ", and the panel-local coordinate is denoted by ",
 Cell[BoxData[
  SubscriptBox[
   StyleBox["x", "TI"], 
   StyleBox["j", "TI"]]], "InlineFormula"],
 ". Strength parameters for the discretized airfoil are grouped as lists,"
}], "DetailNotes",
 CellID->1648985191],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["a", "1"], ",", 
      SubscriptBox["a", "2"], ",", 
      SubscriptBox["a", "3"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["a", "N"]}], ")"}]}], TraditionalForm]], "InlineMath"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"b", "=", 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox["b", "1"], ",", 
      SubscriptBox["b", "2"], ",", 
      SubscriptBox["b", "3"], ",", "\[Ellipsis]", ",", 
      SubscriptBox["b", "N"]}], ")"}]}], TraditionalForm]], "InlineMath"],
 "."
}], "DetailNotes",
 CellID->1513925551],

Cell[TextData[{
 "There are ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "N"}], TraditionalForm]], "InlineMath"],
 " unknown strength parameters in the formulation of this model. Tangent-flow \
boundary conditions at collocation points provide ",
 Cell[BoxData[
  FormBox["N", TraditionalForm]], "InlineMath"],
 " equations. Collocation points are placed at mid-panel, just outside the \
airfoil. Continuity of circulation density between panels (except at trailing \
edge) provides ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", "-", "1"}], TraditionalForm]], "InlineMath"],
 " equations, and a Kutta condition (zero circulation density at trailing \
edge) provides the final equation for a system of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "N"}], TraditionalForm]], "InlineMath"],
 " linear algebraic equations involving the unknown strength parameters. The \
system of equations is solved using the ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " function ",
 StyleBox["LinearSolve", "MR"],
 "."
}], "DetailNotes",
 CellID->245444425],

Cell["\<\
This Demonstration uses dimensionless parameters, with the characteristic \
length of the problem being the chord of the airfoil and the characteristic \
speed being that of the uniform onset flow.\
\>", "DetailNotes",
 CellID->896499283],

Cell["References", "DetailNotes",
 CellID->843918668],

Cell[TextData[{
 "[1] I. H. Abbott and A. E. von Doenhoff, ",
 StyleBox["Theory of Wing Sections",
  FontSlant->"Italic"],
 ", New York: Dover Publications, 1949."
}], "DetailNotes",
 CellID->629057764],

Cell[TextData[{
 "[2] J. Katz and A. Plotkin, ",
 StyleBox["Low-Speed Aerodynamics",
  FontSlant->"Italic"],
 ", 2nd ed., Cambridge: Cambridge University Press, 2001."
}], "DetailNotes",
 CellID->72422503],

Cell[TextData[{
 "[3] UIUC Applied Aerodynamics Group, ",
 StyleBox["UIUC Airfoil Data Site",
  FontSlant->"Italic"],
 ". ",
 ButtonBox["http://www.ae.illinois.edu/m-selig/ads.html",

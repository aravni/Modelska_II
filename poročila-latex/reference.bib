@article{N_pendulum_2,
  doi = {10.1088/1742-6596/2307/1/012059},
  url = {https://dx.doi.org/10.1088/1742-6596/2307/1/012059},
  year = {2022},
  month = {sep},
  publisher = {IOP Publishing},
  volume = {2307},
  number = {1},
  pages = {012059},
  author = {Alicia Cid and Pedro J Díaz and Jaime A Granados and Juan M Velázquez A and Marco A Zurita and Alberto Mina and Joshua A Velázquez and Luisa G del valle},
  title = {Dynamic study of the pendulum-n and the beginning of chaos.},
  journal = {Journal of Physics: Conference Series},
  abstract = {The purpose of this work was to analyze theoretically and numerically the system of the n pendulum, with n = 2, 3, 4, 5 pendulums. The first corresponds to the classical analysis of the double pendulum, the second case corresponds to the triple pendulum, the third case refers to the quadruple pendulum, finally, the fourth case corresponds to the fivefold pendulum, considering for all cases the same values of mass and length. We obtained the coupled equations of motion for each case using Lagrange´s formulation. Simulations were carried out and equations of motion were solved using Runge Kutta Butcher’s explicit higher-order numerical method. The results of the numerical solution are presented, which show that the movement tends to be chaotic when placing more pendulums to the system. It can also be observed that this is the beginning to study the sections of Poincaré.}
}
